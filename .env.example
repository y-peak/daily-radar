# 复制成 .env 再填真值。**这个文件可以入库，.env 不行**（.gitignore 里已排除）。
#
# 为什么 key 不写在 config.json：config.json 是要推到公开仓库的。
# 环境变量 > config.json，这个优先级本身就是安全措施。

# 服务监听（走 HTTPS 反代时用这套：radar 只监听本机，不允许绕过 TLS 直连）
RADAR_HOST=127.0.0.1
RADAR_PORT=18090
# healthcheck.sh 校验证书 SAN 用
RADAR_IP=118.196.100.121
# 访问口令，随机一串即可：# tr -dc 'a-f0-9' < /dev/urandom | head -c 16
RADAR_TOKEN=

# 大模型 key（可选）。不填 = 自动降级成免 key 翻译 + 无中文介绍，功能照常。
# 供应商在 config.json 的 llm.provider 里改，都是 OpenAI 兼容协议。
RADAR_LLM_KEY=
