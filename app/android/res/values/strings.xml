<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">个人情报台</string>
    <string name="offline_hint">暂时连不上服务器\n请检查手机网络后重试</string>
    <string name="retry">重试</string>
    <string name="auth_failed">访问口令失效了\n请用带口令的地址重新打开一次</string>

    <!-- 更新提示。两个 %s 分别是"新版本"和"当前版本" -->
    <string name="update_title">发现新版本</string>
    <string name="update_msg">有新版本 v%1$s 可用（当前 v%2$s）。\n是否现在下载？下完会直接调起系统安装。</string>
    <string name="update_now">立即更新</string>
    <string name="update_later">以后再说</string>
    <string name="update_skip">跳过这个版本</string>

    <!-- 用户主动点「检查更新」后的反馈：自动检查可以静默，主动问必须有回答 -->
    <string name="update_is_latest">已是最新版本 v%1$s</string>
    <string name="update_check_failed">检查更新失败，请检查网络后重试</string>

    <!-- 应用内下载安装。
         口径变了：不再"交给浏览器"，所以文案里不能再说"下载后点安装包"。
         同时要诚实 —— 系统那一次安装确认绕不过去（安卓对非应用商店应用的硬性要求），
         写进提示里，比让用户以为"点了没反应"要好。 -->
    <string name="update_dl_title">正在下载更新</string>
    <string name="update_downloading">正在下载 v%1$s…</string>
    <string name="update_downloading_pct">正在下载 v%1$s… %2$d%%</string>
    <string name="update_dl_failed">下载失败，请检查网络后重试</string>
    <string name="update_need_perm">需要先允许本应用「安装未知应用」，授权后会自动接着装</string>
    <string name="update_no_installer">系统里没有能安装应用的组件</string>
    <string name="update_auto_started">正在后台下载 v%1$s…</string>
    <string name="update_auto_ready">更新已下好，正在调起安装</string>

    <!-- 规划到期提醒（系统通知）。
         追求的效果是"跟微信来消息一样"：顶上弹出来、有声有震动、留在通知栏。
         所以渠道的 importance 必须是 HIGH —— DEFAULT 只是条不出声的横幅，
         达不到用户要的那个效果。

         文案里刻意不写"提醒您"这类敬语，用"别忘了"这种日常说法，
         和面板里的语气保持一致。 -->
    <string name="notify_channel">规划提醒</string>
    <string name="notify_channel_desc">规划到期当天早上 9:00 提醒你</string>
    <string name="notify_due_one">「%1$s」今天到期</string>
    <string name="notify_due_many">%1$d 条规划今天到期</string>
    <string name="notify_due_text_one">今天到期了，别忘了</string>

    <!-- 测试提醒：设置页那个按钮发出来的，内容和真的到期提醒长得一样 -->
    <string name="notify_test_title">规划提醒（测试）</string>
    <string name="notify_test_text">提醒是通的 —— 到期那天就会这样弹出来</string>
    <string name="notify_test_big">这是一条测试提醒。\n到期的规划会在当天早上 9:00 用这条通知提醒你，点开直接进规划面板。</string>

    <!-- 授权过程里的反馈。给不出通知权限时必须说清楚，不能"点了没反应" -->
    <string name="notify_need_perm">需要先允许「发送通知」，授权后到期才提醒得到你</string>
    <string name="notify_granted">已开启通知提醒</string>
    <string name="notify_denied">没给通知权限，到期提醒发不出来</string>
    <string name="notify_test_failed">发不出来 —— 检查一下通知权限</string>
    <string name="notify_already">通知权限本来就是开的</string>
    <string name="notify_no_autostart_page">这台手机没有自启动设置页，去应用详情里找「自启动 / 后台运行」</string>
</resources>
